# ColdChainIQ Environment Configuration
# Copy this file to .env to customize settings

# Kafka / Redpanda Broker Configuration
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=sensor.readings
KAFKA_DLQ_TOPIC=sensor.dlq
KAFKA_GROUP_ID=coldchain-ingest
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Consumer Micro-batching Configuration
BATCH_SIZE=500
BATCH_MAX_WAIT_MS=1000

# Redis Cache & Window Configuration
REDIS_URL=redis://localhost:6379/0
WINDOW_MINUTES=60
LATEST_TTL_SECONDS=86400
DEDUPE_TTL_SECONDS=7200

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coldchainiq
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5432/coldchainiq
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Consumer Reliability & Retries
MAX_RETRIES=5
HEALTH_PORT=8081
LOG_LEVEL=INFO

# Fleet Simulator Configuration
SIM_KAFKA_BOOTSTRAP=localhost:9092
SIM_KAFKA_TOPIC=sensor.readings
SIM_TRUCKS=10
SIM_DAYS=30
SIM_INTERVAL_SEC=60
SIM_SEED=42
SIM_TIME_SCALE=60.0
SIM_EXCURSION_PROB=0.05
SIM_BAD_EVENT_RATE=0.02
SIM_CARGO_MIX=VACCINE:0.3,DAIRY:0.3,FROZEN_FOOD:0.25,FRESH_PRODUCE:0.15
SIM_START_DATE=2026-05-01T00:00:00Z
SIM_OUT_DIR=./data/raw

# Port Allocation Table:
# Service          | Container Port | Host Port | Protocol / Listener | Used By
# -----------------+----------------+-----------+---------------------+------------------------------
# Redpanda (Kafka) | 29092          | None      | PLAINTEXT (internal)| Simulator & Consumer (Docker)
# Redpanda (Kafka) | 9092           | 9092      | OUTSIDE (external)  | Host applications & live CLI
# Redpanda (Admin) | 9644           | 9645      | HTTP / Admin API    | Cluster health / rpk from host
# Redpanda Console | 8080           | 8080      | HTTP (Web UI)       | Topic & message browser UI
# PostgreSQL       | 5432           | 5432      | PostgreSQL          | Ingestion repository & API
# Redis            | 6379           | 6379      | RESP                | Cache, Dedupe, Rolling window
# Consumer Health  | 8081           | 8081      | HTTP                | Health check & metrics probe
