# ColdChainIQ Environment Configuration
# Copy this file to .env to customize settings

# Kafka / Redpanda Broker Configuration
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=sensor.readings
KAFKA_DLQ_TOPIC=sensor.dlq
KAFKA_GROUP_ID=coldchain-ingest
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Consumer Micro-batching Configuration
BATCH_SIZE=500
BATCH_MAX_WAIT_MS=1000

# Redis Cache & Window Configuration (Host Port: 6380, Compose Internal: 6379)
REDIS_URL=redis://localhost:6380/0
WINDOW_MINUTES=60
LATEST_TTL_SECONDS=86400
DEDUPE_TTL_SECONDS=7200

# PostgreSQL Configuration (Host Port: 5433, Compose Internal: 5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coldchainiq
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@localhost:5433/coldchainiq
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Consumer Reliability & Retries
MAX_RETRIES=5
HEALTH_PORT=8081
LOG_LEVEL=INFO

# ==============================================================================
# Phase 3: Authentication, JWT & RBAC API Configuration
# ==============================================================================
# Secret generation command: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=super_secret_jwt_signing_key_at_least_32_bytes_long_coldchainiq_2026
JWT_ALGORITHM=HS256
JWT_ISSUER=coldchainiq-api
JWT_AUDIENCE=coldchainiq-clients
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:8002
ALLOW_SELF_REGISTRATION=true
REQUIRE_APPROVAL=false
LOGIN_RATE_LIMIT_PER_MIN=5
LOGIN_IP_RATE_LIMIT_PER_MIN=20
REGISTER_RATE_LIMIT_PER_HOUR=5
REFRESH_RATE_LIMIT_PER_MIN=30
HSTS_ENABLED=false
API_PORT=8002

# Fleet Simulator Configuration
SIM_KAFKA_BOOTSTRAP=localhost:9092
SIM_KAFKA_TOPIC=sensor.readings
SIM_TRUCKS=10
SIM_DAYS=30
SIM_INTERVAL_SEC=60
SIM_SEED=42
SIM_TIME_SCALE=60.0
SIM_EXCURSION_PROB=0.05
SIM_BAD_EVENT_RATE=0.02
SIM_CARGO_MIX=VACCINE:0.3,DAIRY:0.3,FROZEN_FOOD:0.25,FRESH_PRODUCE:0.15
SIM_START_DATE=2026-05-01T00:00:00Z
SIM_OUT_DIR=./data/raw

# Port Allocation Table:
# Service          | Container Port | Host Port | Protocol / Listener | Used By
# -----------------+----------------+-----------+---------------------+------------------------------
# Redpanda (Kafka) | 29092          | None      | PLAINTEXT (internal)| Simulator & Consumer (Docker)
# Redpanda (Kafka) | 9092           | 9092      | OUTSIDE (external)  | Host applications & live CLI
# Redpanda (Admin) | 9644           | 9645      | HTTP / Admin API    | Cluster health / rpk from host
# Redpanda Console | 8080           | 8080      | HTTP (Web UI)       | Topic & message browser UI
# PostgreSQL       | 5432           | 5433      | PostgreSQL          | Ingestion repository & API
# Redis            | 6379           | 6380      | RESP                | Cache, Dedupe, Token Denylist
# API Service      | 8002           | 8002      | HTTP (REST & Docs)  | FastAPI, RBAC, Auth & Swagger
# Consumer Health  | 8081           | 8081      | HTTP                | Health check & metrics probe
